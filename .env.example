# You need NONE of these to build, typecheck, or run the test suite.
# Each block below is needed only for the workflow it names, so copy the block you
# are actually doing rather than filling in the whole file.

# --- Building a distribution: `yarn pipeline <snapshot>` ------------------------
# Optional. The address that will pay out, checked against tokenTotal in stage 4.
# LEAVING THIS UNSET SKIPS THAT CHECK — the pipeline warns loudly when it does.
DISTRIBUTION_ADDRESS=

# --- Running the mainnet-fork rehearsal test ------------------------------------
# All four required together, or the test skips (which is what CI does).
MAINNET_RPC_URL=
FORK_PROXY=
FORK_PROXY_ADMIN=
FORK_ADMIN_OWNER=
# Optional: pin the fork to a block so runs are reproducible and cached.
FORK_BLOCK_NUMBER=

# --- Deploying the implementation ------------------------------------------------
# `npx hardhat run scripts/deploy/deployMerkleDistributorETH.ts --network mainnet`
MAINNET_RPC_URL=
PRIVATE_KEY=
MERKLE_RESULT=build/merkle-result.json
DISTRIBUTOR_OWNER=
# Claim window length in seconds, added to the deploy block timestamp.
CLAIM_WINDOW_SECONDS=31536000
# Optional. If set, the script checks this address holds at least tokenTotal and
# aborts if it does not, before spending any gas.
FUNDING_ADDRESS=
# Optional. If set, the script rejects a DISTRIBUTOR_OWNER equal to either, which
# would make withdraw() permanently uncallable.
PROXY=
PROXY_ADMIN=

# --- Producing the Safe upgrade transaction --------------------------------------
# `npx ts-node scripts/deploy/proposeUpgrade.ts -o upgrade.json`
PROXY=
PROXY_ADMIN=
IMPLEMENTATION=
# Optional, defaults to 1 (mainnet).
CHAIN_ID=

# --- Contract verification --------------------------------------------------------
ETHERSCAN_API_KEY=

# --- Optional -----------------------------------------------------------------------
# "true" prints a gas report during tests.
REPORT_GAS=false
