# Five values. Set them once and the whole deploy flow works.
# None are needed to build, typecheck or run the test suite.

# --- The deployment ---------------------------------------------------------------
# The existing upgradeable proxy that holds the ETH and will receive the new
# implementation. Also used as the funding address the pipeline balance-checks
# against, and to reject a DISTRIBUTOR_OWNER that would brick withdraw().
PROXY=

# The ProxyAdmin that owns PROXY. The Safe transaction is addressed to this.
PROXY_ADMIN=

# Immutable owner of the distributor: receives the unclaimed remainder after the
# claim window closes. Cannot be changed after deployment. Normally the Safe.
DISTRIBUTOR_OWNER=

# --- Access -----------------------------------------------------------------------
MAINNET_RPC_URL=
# Deployer key. Only needed for `yarn deploy:mainnet`.
PRIVATE_KEY=
# Only needed for `npx hardhat verify`.
ETHERSCAN_API_KEY=

# --- Optional ---------------------------------------------------------------------
# Claim window length in seconds, added to the deploy block timestamp. Default 1 year.
CLAIM_WINDOW_SECONDS=31536000
# Override the pipeline's default output (dist/merkle-result.json).
MERKLE_RESULT=
# Override the implementation address, which otherwise comes from dist/deployment.json.
IMPLEMENTATION=
# Chain ID recorded in the Safe batch. Default 1.
CHAIN_ID=
# "true" prints a gas report during tests.
REPORT_GAS=false

# --- Fork rehearsal test (all four, or the test skips) ------------------------------
FORK_PROXY=
FORK_PROXY_ADMIN=
FORK_ADMIN_OWNER=
FORK_BLOCK_NUMBER=
