# JSON-RPC endpoint for mainnet. Required for deployment and for the fork tests.
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/XXXX
# Optional: pin the fork to a block for reproducible test runs.
FORK_BLOCK_NUMBER=
# Deployer key. Only needed for actual deployment.
PRIVATE_KEY=
# Etherscan v2 API key, for contract verification.
ETHERSCAN_API_KEY=
# Set to "true" to print a gas report during tests.
REPORT_GAS=false

# --- Fork rehearsal test (all four required, or the test skips) ---
# JSON-RPC endpoint for the fork (same variable as MAINNET_RPC_URL above).
# The proxy whose implementation will be replaced.
FORK_PROXY=
# The ProxyAdmin that owns that proxy.
FORK_PROXY_ADMIN=
# The account that owns the ProxyAdmin; impersonated during the test.
FORK_ADMIN_OWNER=

# --- Pipeline / deploy scripts (scripts/pipeline.sh, scripts/deploy/*) ---
# Path to the generate-merkle-root.ts output, consumed by the deploy script.
MERKLE_RESULT=
# Address set as the immutable owner of the deployed MerkleDistributorETH.
DISTRIBUTOR_OWNER=
# Claim window length in seconds, added to the deploy block's timestamp.
CLAIM_WINDOW_SECONDS=31536000
# Address expected to fund the proxy; its balance is checked against tokenTotal
# by deployMerkleDistributorETH.ts before deploying.
FUNDING_ADDRESS=
# Address check-distribution.ts (via pipeline.sh stage 4) checks holds at least
# tokenTotal. Leaving this unset SKIPS that balance check — pipeline.sh will warn.
DISTRIBUTION_ADDRESS=
# The existing upgradeable proxy that will receive the new implementation.
PROXY=
# The ProxyAdmin contract that owns PROXY.
PROXY_ADMIN=
# The deployed MerkleDistributorETH implementation address, for proposeUpgrade.ts.
IMPLEMENTATION=
# Chain ID recorded in the Safe Transaction Builder batch (default: 1, mainnet).
CHAIN_ID=
