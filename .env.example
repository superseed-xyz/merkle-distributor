# JSON-RPC endpoint for mainnet. Required for deployment and for the fork tests.
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/XXXX
# Optional: pin the fork to a block for reproducible test runs.
FORK_BLOCK_NUMBER=
# Deployer key. Only needed for actual deployment.
PRIVATE_KEY=
# Etherscan v2 API key, for contract verification.
ETHERSCAN_API_KEY=
# Set to "true" to print a gas report during tests.
REPORT_GAS=false

# --- Fork rehearsal test (all three required, or the test skips) ---
# The proxy whose implementation will be replaced.
FORK_PROXY=
# The ProxyAdmin that owns that proxy.
FORK_PROXY_ADMIN=
# The account that owns the ProxyAdmin; impersonated during the test.
FORK_ADMIN_OWNER=
